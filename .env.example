# --- required --------------------------------------------------------------
# Railway sets this for you when you attach the Postgres plugin.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- app -------------------------------------------------------------------
PORT=3000
APP_NAME=Pre-Order Watch
# Railway injects RAILWAY_PUBLIC_DOMAIN, so you can usually leave this unset.
# PUBLIC_URL=https://your-app.up.railway.app

# Adding, editing, and removing stores is open to anyone who can reach the app
# until this is set. Set it before sharing the URL publicly.
# ADMIN_TOKEN=

# --- Twilio (leave blank while building the UI) ----------------------------
# With these unset the app runs normally and prints texts to the logs instead
# of sending them, including the sign-in verification code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional. If set it is used instead of TWILIO_FROM_NUMBER and gives you
# Twilio's built-in STOP/START handling.
TWILIO_MESSAGING_SERVICE_SID=

# --- optional: create a store on first boot --------------------------------
# Stores are normally added through the UI. This just saves doing it by hand on
# a fresh deploy. Leave SEED_SITE_COLLECTIONS blank to accept the top matches.
# SEED_SITE_URL=https://hobbiesville.com
# SEED_SITE_COLLECTIONS=pre-orders,pre-order-board-games,pre-order-toys

# --- polling ---------------------------------------------------------------
POLL_INTERVAL_SECONDS=300
POLL_ENABLED=true
NOTIFY_COOLDOWN_HOURS=24
MAX_PAGES_PER_COLLECTION=10

# --- limits ----------------------------------------------------------------
DEFAULT_PHONE_COUNTRY=US
MAX_WATCHES=100
MAX_SITES=25
